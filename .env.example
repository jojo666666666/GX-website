# Outbound inquiry email (required)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=website@example.com
SMTP_PASS=replace-with-an-app-password
SMTP_FROM=website@example.com
CONTACT_EMAIL=Sales@ganxingtools.com

# Baidu verification (optional)
NEXT_PUBLIC_BAIDU_SITE_VERIFICATION=

# Cloudflare Turnstile anti-spam (optional; set both values together)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Inquiry CRM/database webhook (optional)
INQUIRY_WEBHOOK_URL=
INQUIRY_WEBHOOK_TOKEN=
